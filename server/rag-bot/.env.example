# ========== HTTP 服务 ==========
PORT=8787
# 允许的跨域来源（逗号分隔，* 表示全部；经 Vite 代理访问时可保持默认）
CORS_ORIGIN=*

# ========== 持久化与生产门禁 ==========
# 开发默认 ./data；生产必须显式配置到本机持久卷，所有进程共用同一目录。
RAGBOT_DATA_DIR=./data
# NODE_ENV=production
# 生产必须设置独立随机密钥，至少 32 字节；不要使用演示默认值。
# RAGBOT_PROPOSAL_SECRET=
# 生产业务适配器必须导出 createTools({ ticketService })，详见 README。
# RAGBOT_BUSINESS_MODULE=./adapters/business.ts
# 权限来自服务端配置；同一线程的权限变更后必须新建线程。
# RAGBOT_KNOWLEDGE_SCOPES=[{"tenantId":"tenant-demo","principal":"alice","products":["pro"],"regions":["cn"],"roles":["support"],"permissions":["billing"]}]

# ========== 账号表（人：通过 /login 换 token） ==========
# 格式：用户名:密码:租户ID，多账号用逗号分隔
RAGBOT_USERS=demo:demo123:tenant-demo,alice:alice123:tenant-demo
# 签发的 token 有效期（秒），默认 7 天；服务重启后已签发 token 失效，需重新登录
RAGBOT_TOKEN_TTL_SECONDS=604800

# ========== 系统 token 表（系统：直接配发，无需登录，API Key 语义） ==========
# 格式：token:租户ID:调用方标识，多个用逗号分隔
# RAGBOT_SYSTEM_TOKENS=sys-token-order:tenant-demo:order-system

# ========== 知识库自动灌库 ==========
# 服务启动时若 Qdrant collection 为空，自动 ingest KNOWLEDGE_DIR 下的 .md 文件
AUTO_INGEST=true
KNOWLEDGE_DIR=./knowledge

# ========== 流式输出（先审后发） ==========
# strict 为默认且生产必选：完成终审、checkpoint 和入口结果落盘后再发出文本。
# chunked/async 仅保留开发兼容协议，当前也先收集完整图事件，不提供首 token 延迟优势。
REVIEW_STREAM_MODE=strict
# 传输层节奏：每个片段字符数与间隔毫秒（句号/换行/逗号后按倍数额外停顿）；0 = 不节流
STREAM_CHUNK_SIZE=12
STREAM_CHUNK_DELAY_MS=22
# 专家直通（首字延迟优化）：单类别查询跳过 specialist/orchestration，省一次串行 LLM 调用（约 3-8s）。
# 多类别 / 需要实时数据的查询不受影响。默认 always（原行为）。
SPECIALIST_POLICY=skipSingleCategory

# ========== 演示模式（不接真实大模型） ==========
# true 时注入内置 fake LLM（固定话术），不调用任何外部 API，便于本地联调
USE_FAKE_LLM=false

# ========== LLM 对话模型（接真实回答时必填，OpenAI 兼容） ==========
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model-name

# ========== Rerank 重排（可选，不配置则关闭重排） ==========
# ⚠️ 模力方舟（api.moark.com）模型名不带组织前缀；硅基流动必须带（如 BAAI/bge-reranker-v2-m3）
# ⚠️ base 填到 /v1 为止，客户端自己拼 /rerank
RERANK_API_KEY=
RERANK_BASE_URL=https://api.moark.com/v1
RERANK_MODEL=Qwen3-Reranker-4B

# ========== Qdrant 向量库 ==========
# 不配置时检索为空（安全降级，图仍可直答）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_bot

# ========== Embedding 嵌入模型 ==========
# ⚠️ 模力方舟模型名不带组织前缀；base 填到 /v1，客户端自己拼 /embeddings
USE_FAKE_EMBEDDINGS=false
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.moark.com/v1

# ========== 影子模式弱标签采集（置信度标定数据） ==========
# 记录每轮闸门判决 + 下一轮用户行为弱标签（转人工/重复提问/会话解决），
# 攒够后导出给 rag-boot 的 pnpm calibrate 做实测标定。只记录不干预判决。
# 快照含用户 query 原文（PII）：生产默认关闭，开发默认开启。
# SHADOW_LABELS=true
# SHADOW_LABELS_PATH=./data/shadow-labels.json
# 标定 profile 的分组键（与 rag-boot seed-queries.json 的口径保持一致）：
# SHADOW_KB_VERSION=kb-2026-09-live-knowledge
# SHADOW_DOMAIN=优选商城售后

# ========== Langfuse 可观测性（可选） ==========
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
