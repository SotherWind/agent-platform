# ========== 应用环境 ==========
# 运行环境（必填：development | test | staging | production）
APP_ENV=development
# HTTP 服务端口
PORT=3000
# 请求超时时间（毫秒，默认 120000）
# REQUEST_TIMEOUT_MS=120000
# MAX_REQUEST_BODY_BYTES=1048576
# REQUEST_BODY_TIMEOUT_MS=10000
# 配置版本号（默认 1）
# CONFIG_VERSION=1

# ========== LLM 对话模型 ==========
# 大模型 API 密钥
MODEL_API_KEY=your-api-key-here
# 大模型 API 地址（OpenAI 兼容）
MODEL_BASE_URL=https://api.example.com/v1
# 大模型名称
MODEL_NAME=your-model-name

# ========== Qdrant 向量库（Schema RAG，可选） ==========
# 不配置 QDRANT_URL 时使用内存 demo retriever
# Qdrant 服务地址（本地 qdrant.exe 默认 6333 端口）
QDRANT_URL=http://localhost:6333
# Qdrant API 密钥（本地默认可留空；Qdrant Cloud 或开启鉴权时必填）
QDRANT_API_KEY=
# Schema 元数据 collection 别名
QDRANT_METADATA_ALIAS=bi-metadata-active

# ========== Embedding 嵌入模型 ==========
# 是否使用假嵌入（true=本地测试，false=调用真实 API）
# 开发环境建议 true，避免依赖外部 embedding
USE_FAKE_EMBEDDINGS=true
# 嵌入模型名称（SiliconFlow 需带 Qwen/ 前缀）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 嵌入服务 API 密钥
EMBEDDING_API_KEY=your-embedding-api-key-here
# 嵌入服务 API 地址（填到 /v1，客户端会自动请求 /embeddings）
EMBEDDING_BASE_URL=https://api.example.com/v1
# 嵌入向量维度（需与模型匹配，默认 1024）
# EMBEDDING_VECTOR_SIZE=1024

# ========== Agent 重试次数 ==========
# SQL 执行失败后的最大自愈重试次数
MAX_RETRY_COUNT=3

# ========== Text-to-SQL LLM 评测（可选） ==========
# 设为 1 时，pnpm verify:llm-eval 会调用真实模型对照 golden 打分
# ENABLE_LIVE_LLM_EVAL=1
# REQUIRE_LIVE_LLM_EVAL=1
# live 评测最低通过率（默认 0.67）
# LLM_EVAL_MIN_PASS_RATE=0.85

# ========== Docker MySQL / MariaDB / PostgreSQL（本地连库扫描） ==========
# 先 pnpm docker:up，再 pnpm test:live-db
# BI_MYSQL_HOST=127.0.0.1
# BI_MYSQL_PORT=3306
# BI_MYSQL_USER=bi
# BI_MYSQL_PASSWORD=bi_dev
# BI_MYSQL_DATABASE=retail
# MariaDB（宿主机 3307）
# BI_MARIADB_HOST=127.0.0.1
# BI_MARIADB_PORT=3307
# BI_MARIADB_USER=bi
# BI_MARIADB_PASSWORD=bi_dev
# BI_MARIADB_DATABASE=retail
# BI_PG_HOST=127.0.0.1
# BI_PG_PORT=5432
# BI_PG_USER=bi
# BI_PG_PASSWORD=bi_dev
# BI_PG_DATABASE=retail
# BI_PG_SCHEMA=public
# Workspace default source; business queries do not need database/table names.
# BI_DEFAULT_DATASOURCE_ID=sales_mysql
# 设为 1 时，dev 启动会把 live MySQL/MariaDB/PG 挂进 ExecutorRegistry + DataSourceRegistry
# BI_ATTACH_LIVE_DATASOURCES=1
# Deployment connection fields come from DATASOURCE_REGISTRY_PATH. BI_* host/user/database
# values above are only for Docker integration tools; Registry secretRef may still reference
# BI_MYSQL_PASSWORD / BI_MARIADB_PASSWORD / BI_PG_PASSWORD.
# BI_MYSQL_DATASOURCE_ID=sales_mysql
# BI_MARIADB_DATASOURCE_ID=sales_mariadb
# BI_PG_DATASOURCE_ID=analytics_pg
# quasi-production 审计落库（Docker PG 或云 RDS）
# AUDIT_DATABASE_URL=postgresql://bi:bi_dev@127.0.0.1:5432/retail
# 查询历史（缺省复用 AUDIT_DATABASE_URL）
# HISTORY_DATABASE_URL=postgresql://bi:bi_dev@127.0.0.1:5432/retail
# LangGraph checkpointer（缺省复用 HISTORY/AUDIT）
# CHECKPOINT_DATABASE_URL=postgresql://bi:bi_dev@127.0.0.1:5432/retail
# 查询缓存 Redis（L1 内存 + L2 写穿）
# REDIS_URL=redis://127.0.0.1:6379/0
# Redis-backed cache/rate-limit namespaces are versioned by the application.

# ========== SQLite 执行（测试/调试，可选） ==========
# 是否同步执行 SQLite 查询（1=同步，测试环境常用）
# BI_SQLITE_SYNC=1
# staging/production 不会创建或 seed demo DB。若单机部署需要 SQLite，
# 请在 datasource Registry 的 connection.filePath 配置运维挂载的现有文件绝对路径；运行时只读打开。

# ========== 生产环境（staging / production，可选） ==========
# JWT 公钥地址，用于生产环境身份验证
# AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://auth.example.com/
# AUTH_AUDIENCE=bi-analyst
# 数据源注册表路径
# DATASOURCE_REGISTRY_PATH=config/datasources.yaml
# 访问策略配置（JSON）或远程策略服务（二选一）
# POLICY_CONFIG_PATH=config/policies.example.json
# POLICY_SERVICE_URL=https://policy.example.com
# POLICY_SERVICE_PATH=/v1/policies/{tenantId}/{subjectId}
# POLICY_SERVICE_TOKEN=
# POLICY_SERVICE_TIMEOUT_MS=5000
# Optional dependency endpoint used only by /ready.
# POLICY_SERVICE_HEALTH_URL=https://policy.example.com/health
# 密钥读取/轮换审计（生产默认开启；设 0 关闭）
# BI_SECRET_AUDIT=0
# 准生产审计落库（PostgreSQL）
# AUDIT_DATABASE_URL=postgresql://bi:bi_dev@127.0.0.1:5432/retail
# HISTORY_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
# EXPORT_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
# Production state is Redis-authoritative (Session, export jobs, model rollout,
# and metadata review). REDIS_URL is mandatory in APP_ENV=production.
# STATE_VOLUME_PATH=/var/lib/bi-analyst (single-machine staging fallback only)
# FEEDBACK_STATE_PATH=/var/lib/bi-analyst/analysis-feedback.json
# ANALYSIS_JOBS_STATE_PATH=/var/lib/bi-analyst/analysis-jobs.json
# ANALYSIS_STATE_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
# FEEDBACK_RETENTION_DAYS=30
# ANALYSIS_JOB_RETENTION_DAYS=7
# ANALYSIS_JOB_CONCURRENCY=2
# OTEL_SERVICE_NAME=bi-analyst
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_MAX_SPANS=5000
# SESSION_DATABASE_PATH=./data/production-sessions.db (staging fallback only)
# MODEL_REGISTRY_PATH=./data/model-registry.json (staging fallback only)
# METADATA_REVIEW_PATH=./data/metadata-review.json (staging fallback only)
# EXPORT_STORE_PATH=./data/export-jobs.json (staging fallback only)
# HashiCorp Vault（KV v2）；生产默认要求其一，缺省 fail closed
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=hvs.xxx
# 或 AppRole：
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_KV_MOUNT=secret
# AWS Secrets Manager（与 Vault 对称；可多云并存 → CompositeSecretProvider）
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_SECRETS_MANAGER_ENDPOINT=
# Azure Key Vault
# AZURE_KEY_VAULT_NAME=my-vault
# 或 AZURE_KEY_VAULT_URL=https://my-vault.vault.azure.net
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# 仅受控 staging 允许 env SecretProvider（默认禁止）
# BI_ALLOW_ENV_SECRETS=1
# 元数据同步调度（进程内间隔；亦可用系统 cron 调 pnpm sync:metadata）
# METADATA_SYNC_ENABLED=1
# METADATA_SYNC_INTERVAL_MS=3600000
# METADATA_SYNC_MODE=incremental
# METADATA_SYNC_RUN_ON_START=1

# ========== 单机 staging（L4，同一 dist） ==========
# APP_ENV=staging
# BI_SINGLE_MACHINE_STAGING=1
# BI_STAGING_MOCK_AUTH=1
# BI_STAGING_MOCK_ADMIN_KEY=replace-with-a-long-random-value
# BI_ALLOW_INMEMORY_RETRIEVER=1
# DATASOURCE_REGISTRY_PATH=config/datasources.staging-acc.yaml
# POLICY_CONFIG_PATH=config/policies.staging-acc.json
# 默认 staging-acc Registry 仅包含 MySQL/PG；SQLite 需显式挂载文件并另行配置。
# AUTH_OIDC_DISCOVERY_URL=https://idp.example.com
# AUDIT_RETENTION_DAYS=7
# AUDIT_PURGE_INTERVAL_MS=3600000
# SHUTDOWN_TIMEOUT_MS=15000
