# Local acceptance output and temporary probes.
/scripts/_*.txt
/scripts/_*.json
/scripts/_*.mjs
/scripts/_*.ts
/scripts/_*.sql
/scripts/_*.pem

# Runtime state and local secrets.
/data/*
!/data/.gitkeep
/.env
/.env.*
!/.env.example
!/.env*.example

# Generated certificates and private key material.
/docker/**/*.pem
/docker/**/*.key
/docker/**/*.crt
