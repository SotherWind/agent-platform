{
  "name": "@agent-platform/bi-analyst",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env APP_ENV=development tsx watch src/dev-main.ts",
    "start": "cross-env APP_ENV=production node dist/main.js",
    "start:staging": "cross-env APP_ENV=staging node dist/main.js",
    "build": "node scripts/clean-production-dist.mjs && tsc -p tsconfig.build.json && node scripts/fix-dist-esm-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "verify:artifact": "tsx scripts/verify-production-artifact.ts",
    "verify:eval-gate": "tsx scripts/verify-evaluation-gate.ts",
    "verify:routing": "tsx scripts/verify-datasource-routing-gate.ts",
    "verify:llm-eval": "tsx scripts/verify-llm-eval-gate.ts",
    "query:local": "tsx scripts/query-local.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "index:metadata": "tsx scripts/index-demo-metadata.ts",
    "sync:metadata:live": "tsx scripts/sync-live-metadata.ts",
    "sync:metadata": "tsx scripts/sync-metadata.ts",
    "sync:metadata:schedule": "tsx scripts/sync-metadata-schedule.ts",
    "verify:dialect-cert": "tsx scripts/verify-dialect-certification-gate.ts",
    "docker:certs": "node scripts/gen-docker-certs.mjs",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down -v",
    "docker:ps": "docker compose -f docker/docker-compose.yml ps",
    "test": "tsx tests/run.ts",
    "test:unit": "tsx tests/run.ts --unit",
    "test:api-matrix": "tsx scripts/api-matrix.ts",
    "test:api-live": "tsx scripts/live-api-matrix.ts",
    "test:contract": "tsx tests/run.ts --contract",
    "test:security": "tsx tests/run.ts --security",
    "test:integration": "tsx tests/run.ts --integration",
    "test:integration:local": "tsx tests/run.ts --integration --e2e-local",
    "test:integration:services": "tsx tests/run.ts --integration-services",
    "test:live-db": "tsx tests/run.ts --live-db",
    "test:evaluation": "tsx tests/run.ts --evaluation",
    "test:integration:retry": "tsx tests/run.ts --integration-retry",
    "test:e2e:local": "tsx tests/run.ts --e2e-local",
    "test:e2e:staging": "tsx tests/run.ts --e2e-staging"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@agent-platform/llm-sdk": "workspace:*",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.2",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "mysql2": "^3.23.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "node-forge": "^1.4.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
