{
  "policies": [
    {
      "subjectId": "*",
      "tenantId": "tenant-1",
      "policyVersion": "1",
      "roles": ["analyst"],
      "allowedDataSourceIds": [
        "sales_mysql",
        "analytics_pg"
      ],
      "allowedTables": ["users", "orders"],
      "deniedTables": [],
