        "orders": ["id", "user_id", "amount", "status", "created_at"]
      },
      "maskRules": [
        {
          "table": "users",
          "column": "name",
          "strategy": "partial"
        }
      ],
      "minAggregationCount": 2,
      "historyRetentionDays": 7,
      "exportControls": {
        "requireApproval": true,
        "approvalRowThreshold": 1000,
        "sensitiveColumns": ["email", "phone", "token", "password"]
      }
    }
  ]
}
