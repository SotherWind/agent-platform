# ⚠️ 配置指南（不用配两遍）：
# - 前端联调 / 部署时只需配置 server/rag-bot/.env（server 启动会自动回退读取本文件的缺省项）
# - 本文件仅在单独运行本库的脚本（eval、cli 等，cwd=apps/rag-boot）时生效

# ========== LLM 对话模型 ==========
# 大模型 API 密钥
MODEL_API_KEY=your-api-key-here
# 大模型 API 地址（OpenAI 兼容）
MODEL_BASE_URL=https://api.example.com/v1
# 大模型名称
MODEL_NAME=your-model-name

# ========== Rerank 重排（可选，不配置则使用 Mock Rerank） ==========
# 重排服务 API 密钥
RERANK_API_KEY=your-rerank-api-key-here
# 重排服务 API 地址（填到 /v1 为止，客户端自己拼 /rerank）
RERANK_BASE_URL=https://api.moark.com/v1
# 重排模型名称
# ⚠️ 模力方舟（api.moark.com）模型名**不带组织前缀**；硅基流动**必须带**（如 BAAI/bge-reranker-v2-m3）。
# ⚠️ 换 reranker 模型 = 换分数尺度：现役 floor/solid 与全部 profile 都作废，必须重标定。
RERANK_MODEL=Qwen3-Reranker-4B
# 硅基流动备选（注意前缀）：
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ========== Qdrant 向量库 ==========
# Qdrant 服务地址（本地 qdrant.exe 默认 6333 端口）
QDRANT_URL=http://localhost:6333
# Qdrant API 密钥（本地默认可留空；Qdrant Cloud 或开启鉴权时必填）
QDRANT_API_KEY=
# 向量集合名称（切换嵌入模型后若报维度错误，会自动删除旧 collection 并重建）
QDRANT_COLLECTION_NAME=rag_boot

# ========== Embedding 嵌入模型 ==========
# 是否使用假嵌入（true=本地测试，false=调用真实 API）
USE_FAKE_EMBEDDINGS=false
# 嵌入模型名称
# ⚠️ 模力方舟模型名不带组织前缀；硅基流动必须带 Qwen/ 前缀。
# ⚠️ 换 embedding 模型 = 换向量空间，必须重建 Qdrant collection 并重新灌库。
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# 嵌入服务 API 密钥
EMBEDDING_API_KEY=your-embedding-api-key-here
# 嵌入服务 API 地址（填到 /v1，客户端会自动请求 /embeddings）
EMBEDDING_BASE_URL=https://api.moark.com/v1

# ========== Langfuse 可观测性（可选） ==========
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ========== LangChain Tracing（可选） ==========
# LANGCHAIN_TRACING_V2=true
