{
  "name": "@agent-platform/rag-boot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run --pool=threads --no-file-parallelism --no-isolate --maxWorkers=1",
    "test:unit": "vitest run --project unit --pool=threads --no-file-parallelism --no-isolate --maxWorkers=1",
    "test:integration": "vitest run --project integration --pool=threads --no-file-parallelism --no-isolate --maxWorkers=1",
    "test:security": "node scripts/check-security.mjs",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --pool=threads --no-file-parallelism --no-isolate --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/eval/cli.ts",
    "eval:gate": "tsx src/eval/cli.ts --gate",
    "calibrate": "tsx scripts/calibrate-threshold.ts",
    "synthetic:data": "tsx scripts/generate-calibration-data.ts",
    "probe:user-sim": "tsx scripts/probe-user-simulation.ts",
    "verify:provider": "tsx scripts/verify-provider.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@langchain/classic": "^1.0.36",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.2",
    "@langchain/openai": "^1.5.1",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "langchain": "^1.5.2",
    "langfuse-langchain": "^3.38.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
